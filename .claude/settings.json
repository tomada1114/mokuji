{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ruff format . && uv run ruff check --fix . 2>/dev/null; true"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "tomada-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "tomada1114/tomada-claude-plugins"
      }
    }
  },
  "enabledPlugins": {
    "tomada-kit@tomada-claude-plugins": true
  }
}
